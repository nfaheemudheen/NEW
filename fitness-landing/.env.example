# Copy this file to .env.local for local development, or add these variables
# in your hosting dashboard (Vercel/Netlify) and redeploy.

# Option A (recommended for a static site): write enquiries straight to Google
# Sheets through the Apps Script webhook in google-apps-script/Code.gs.
# On Vercel you can instead set SHEETS_WEBHOOK_URL and SHEETS_SHARED_SECRET
# (no VITE_ prefix); api/enquiries.js forwards the request server-side.
VITE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec
VITE_SHEETS_SHARED_SECRET=hs_sync_2f8c1d6a4b9e7f3c5a0d8e6b2c4f7a9d

# Makes the staff portal's "Open spreadsheet" shortcut work.
VITE_SHEETS_SPREADSHEET_ID=15rz8F3nbGLdp4Hkesgfu4RtYJkPtqUyEVLsFbur2gek

# Option B (also enables staff login, pull and delete): the Node API in backend/.
# Set this only after the backend is deployed and reachable.
# VITE_API_BASE_URL=https://your-backend.onrender.com
